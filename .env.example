# Token del bot: inseriscilo solo nel file .env locale o nei secrets del provider.
DISCORD_TOKEN=
# ID applicazione (Developer Portal → General Information). Facoltativo: se manca viene ricavato dal token.
CLIENT_ID=
# ID del server in cui registrare i comandi (registrazione immediata). Se lo ometti i comandi sono globali e Discord può impiegare fino a un'ora a mostrarli.
GUILD_ID=
# ID Discord dell'account di cui mostrare il profilo pubblico.
DISCORD_USER_ID=1241075563985113108
# ID del server pubblico da sincronizzare con il sito (consigliato: obbligatorio se il bot è in più server).
DISCORD_GUILD_ID=1550243283438018660
# Porta API locale (sulle piattaforme di hosting viene usata PORT).
PROFILE_API_PORT=3001
# Origini autorizzate per CORS, separate da virgola. Aggiorna con il dominio reale del sito.
SITE_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
